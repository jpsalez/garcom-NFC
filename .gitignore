.vscode/

# .claude: versionamos o ferramental (agentes, skills, scripts, conhecimento) e deixamos de fora o que é local ou pesado
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/hooks.template.json
!.claude/prompts.md
!.claude/agents/
!.claude/skills/
!.claude/scripts/
!.claude/knowledge/
**/__pycache__/

# Variáveis locais e de produção (nunca no git)
/.env
/.env.prod

# Dependências (cada projeto também ignora a sua; este vale para a raiz)
node_modules/
back-end/.media/
