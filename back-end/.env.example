# Copie para .env (nesta pasta) e preencha. O .env real nunca vai para o git.
# O docker compose (na raiz do projeto) lê este arquivo para configurar a API.
# Gere um segredo com:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d

# API fora do Docker (npm run dev): use o PostgreSQL do compose (porta 5432, só em 127.0.0.1)
DATABASE_URL=postgresql://garcom:garcom@localhost:5432/garcom?schema=public
PORT=4000

# Endereço do front-end (CORS). Vários: separe por vírgula. Sem isso nenhum navegador externo é liberado.
FRONTEND_URL=http://localhost:3000

# Domínio público do front-end: forma a URL do QR Code (<PUBLIC_APP_URL>/m/<código da mesa>)
PUBLIC_APP_URL=http://localhost:3000

# Duração do atendimento da mesa, em segundos (padrão 14400 = 4 h); estender acrescenta o mesmo tempo
# TABLE_SESSION_TTL=14400

# Cache de autenticação em memória, em segundos (padrão 30; 0 desliga)
# AUTH_CACHE_TTL_SECONDS=30

# Opcionais do compose (já são os padrões; descomente só para mudar)
# POSTGRES_USER=garcom
# POSTGRES_PASSWORD=garcom
# POSTGRES_DB=garcom
# DB_PORT=5432
# API_PORT=4000
# WEB_PORT=3000

# Só para `npm run db:seed:super-admin` (cria o SUPER_ADMIN; sem valor padrão, senha com 12+ caracteres).
# Rode e depois apague a senha do .env.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
