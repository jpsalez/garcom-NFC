model print_destinations {
  restaurant_id       String
  destination         print_destination
  enabled             Boolean           @default(false)
  credential_hash     String?           @unique @db.VarChar(64)
  last_contact_at     DateTime?
  interrupted_at      DateTime?
  test_token          String?
  test_status         print_job_status?
  test_expires_at     DateTime?
  mode                print_delivery_mode @default(CLOUDPRNT)
  paper_width         Int                 @default(80)
  browser_test_confirmed Boolean          @default(false)
  restaurant          restaurants       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  jobs                print_jobs[]

  @@id([restaurant_id, destination])
}

model print_jobs {
  id                          String             @id @default(uuid())
  restaurant_id               String
  order_id                    String
  destination                 print_destination
  source_event                String             @db.VarChar(64)
  status                      print_job_status   @default(PENDING)
  payload_version             Int
  payload                     Json
  created_at                  DateTime           @default(now())
  order_version               Int?
  attempts                    Int                @default(0)
  next_attempt_at             DateTime?
  reservation_id              String?            @unique
  reservation_expires_at      DateTime?
  reservation_credential_hash String?            @db.VarChar(64)
  reported_outcome            print_job_outcome?
  delivery_mode               print_delivery_mode?
  original_job_id             String?
  requested_by                String?
  reason                      String?            @db.VarChar(500)
  order                       orders             @relation(fields: [restaurant_id, order_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  print_destination           print_destinations @relation(fields: [restaurant_id, destination], references: [restaurant_id, destination], onDelete: Restrict, onUpdate: Restrict)
  original_job                print_jobs?        @relation("PrintReprints", fields: [restaurant_id, order_id, destination, original_job_id], references: [restaurant_id, order_id, destination, id], onDelete: Restrict, onUpdate: Restrict, map: "print_jobs_original_job_fkey")
  reprints                    print_jobs[]       @relation("PrintReprints")

  @@unique([restaurant_id, order_id, destination, source_event], map: "print_jobs_source_key")
  @@unique([restaurant_id, order_id, destination, id], map: "print_jobs_original_reference_key")
  @@index([restaurant_id, created_at, id])
  @@index([restaurant_id, destination, status, created_at, id], map: "print_jobs_claim_idx")
}

enum print_delivery_mode {
  CLOUDPRNT
  BROWSER
}

enum print_destination {
  KITCHEN
}

enum print_job_status {
  PENDING
  SENDING
  SENT
  FAILED
  SUPPRESSED
  UNCERTAIN
  REVIEW_REQUIRED
}

enum print_job_outcome {
  SENT
  FAILED_BEFORE_SEND
  UNCERTAIN
}

enum tab_kind {
  TABLE
  COUNTER
}

enum tab_status {
  OPEN
  CLOSING
  CLOSED
  CANCELLED
}

model tabs {
  id                       String           @id @default(uuid())
  restaurant_id            String
  number                   Int
  kind                     tab_kind
  table_id                 String?
  table_label_snapshot     String?          @db.VarChar(120)
  label                    String?          @db.VarChar(80)
  guests_count             Int?
  status                   tab_status       @default(OPEN)
  service_fee_bps          Int              @default(1000)
  service_fee_waived       Boolean          @default(false)
  service_fee_waive_reason String?          @db.VarChar(500)
  subtotal_cents           Int              @default(0)
  service_fee_cents        Int              @default(0)
  adjustments_cents        Int              @default(0)
  total_cents              Int              @default(0)
  paid_cents               Int              @default(0)
  /// Estornos ocorridos após o fechamento; preserva o valor liquidado na data de fechamento.
  closed_refunded_cents    Int              @default(0)
  business_date            DateTime?        @db.Date
  /// Histórico de sessões fechadas antes do PDV, sem pagamentos registrados.
  legacy_closed            Boolean          @default(false)
  opened_by_user_id        String?
  closed_by_user_id        String?
  cancel_reason            String?          @db.VarChar(500)
  version                  Int              @default(1)
  opened_at                DateTime         @default(now())
  closed_at                DateTime?
  updated_at               DateTime         @default(now()) @updatedAt

  restaurant restaurants      @relation(fields: [restaurant_id], references: [id], onDelete: Restrict)
  table      tables?          @relation("tabs_table", fields: [restaurant_id, table_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// As FKs SQL de autoria limpam apenas os IDs dos usuários ao excluí-los.
  opened_by  users?           @relation("tabs_opened_by", fields: [restaurant_id, opened_by_user_id], references: [restaurant_id, id], onDelete: SetNull, onUpdate: Restrict)
  closed_by  users?           @relation("tabs_closed_by", fields: [restaurant_id, closed_by_user_id], references: [restaurant_id, id], onDelete: SetNull, onUpdate: Restrict)
  sessions   table_sessions[]
  orders     orders[]
  adjustments tab_adjustments[]
  payment_requests payment_requests[]
  payments payments[]

  @@unique([restaurant_id, id])
  @@unique([restaurant_id, number])
  @@index([restaurant_id, status, opened_at])
  @@index([restaurant_id, business_date, status])
  @@index([restaurant_id, table_id, status])
  @@index([restaurant_id, opened_by_user_id])
  @@index([restaurant_id, closed_by_user_id])
}

enum tab_adjustment_type {
  DISCOUNT
  COUVERT
  TIP
}

enum tab_adjustment_mode {
  FIXED_CENTS
  PERCENT_BPS
}

enum payment_method {
  CASH
  CREDIT
  DEBIT
  PIX
  VOUCHER
  OTHER
}

enum payment_status {
  PENDING
  PROCESSING
  APPROVED
  DECLINED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum payment_provider_type {
  MANUAL
  MERCADO_PAGO
  STONE
  PAGBANK
  CIELO
  PAYGO
  SITEF
}

enum payment_request_status {
  OPEN
  ACCEPTED
  CONVERTED
  CANCELLED
  EXPIRED
}

model tab_adjustments {
  id                 String              @id @default(uuid())
  restaurant_id      String
  tab_id             String
  type               tab_adjustment_type
  mode               tab_adjustment_mode
  value              Int
  computed_cents     Int
  reason             String              @db.VarChar(500)
  created_by_user_id String?
  created_at         DateTime            @default(now())
  removed_at         DateTime?
  removed_by_user_id String?
  remove_reason      String?             @db.VarChar(500)

  tab        tabs   @relation(fields: [restaurant_id, tab_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// As FKs SQL de autoria limpam apenas os IDs dos usuários ao excluí-los.
  created_by users? @relation("tab_adjustment_created_by", fields: [restaurant_id, created_by_user_id], references: [restaurant_id, id], onDelete: SetNull, onUpdate: Restrict)
  removed_by users? @relation("tab_adjustment_removed_by", fields: [restaurant_id, removed_by_user_id], references: [restaurant_id, id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([restaurant_id, id])
  @@index([restaurant_id, tab_id, removed_at])
  @@index([restaurant_id, created_by_user_id])
  @@index([restaurant_id, removed_by_user_id])
}

model payment_requests {
  id                     String                 @id @default(uuid())
  restaurant_id          String
  tab_id                 String
  session_id             String
  session_token_id       String
  payer_label            String                 @db.VarChar(60)
  preferred_method       payment_method
  requested_amount_cents Int
  selection_json         Json
  status                 payment_request_status @default(OPEN)
  payment_id             String?
  handled_by_user_id     String?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @default(now()) @updatedAt

  tab           tabs           @relation(fields: [restaurant_id, tab_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  session       table_sessions @relation(fields: [restaurant_id, session_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  session_token session_tokens @relation(fields: [session_token_id, session_id], references: [id, session_id], onDelete: Restrict, onUpdate: Restrict)
  payment       payments?      @relation(fields: [restaurant_id, payment_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// A FK SQL limpa apenas handled_by_user_id ao excluir o usuário.
  handled_by    users?         @relation("payment_request_handled_by", fields: [restaurant_id, handled_by_user_id], references: [restaurant_id, id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([restaurant_id, id])
  @@unique([restaurant_id, payment_id])
  @@index([restaurant_id, tab_id, status])
  @@index([restaurant_id, session_id, status])
  @@index([session_token_id, session_id])
  @@index([restaurant_id, handled_by_user_id])
}

model payments {
  id                   String                @id @default(uuid())
  restaurant_id        String
  tab_id               String
  cash_shift_id        String?
  provider             payment_provider_type @default(MANUAL)
  terminal_id          String?
  provider_account_id  String?
  method               payment_method
  status               payment_status
  amount_cents         Int
  received_cents       Int?
  change_cents         Int                   @default(0)
  tip_cents            Int                   @default(0)
  provider_fee_cents   Int?
  payer_label          String?               @db.VarChar(60)
  idempotency_key      String                @db.VarChar(64)
  request_hash         String                @db.VarChar(64)
  external_payment_id  String?               @db.VarChar(128)
  nsu                  String?               @db.VarChar(64)
  authorization_code   String?               @db.VarChar(64)
  card_brand           String?               @db.VarChar(32)
  acquirer_cnpj        String?               @db.VarChar(14)
  installments         Int                   @default(1)
  raw_provider_payload Json?
  actor_user_id        String?
  refund_reason        String?               @db.VarChar(500)
  refunded_by_user_id  String?
  confirmed_at         DateTime?
  refunded_at          DateTime?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @default(now()) @updatedAt

  tab             tabs                  @relation(fields: [restaurant_id, tab_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  cash_shift      cash_shifts?          @relation(fields: [restaurant_id, cash_shift_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  provider_account payment_provider_accounts? @relation(fields: [restaurant_id, provider, provider_account_id], references: [restaurant_id, provider, id], onDelete: Restrict, onUpdate: Restrict, map: "payments_provider_account_fkey")
  terminal         payment_terminals?          @relation(fields: [restaurant_id, terminal_id, provider, provider_account_id], references: [restaurant_id, id, provider, provider_account_id], onDelete: Restrict, onUpdate: Restrict, map: "payments_terminal_fkey")
  /// As FKs SQL de autoria limpam apenas os IDs dos usuários ao excluí-los.
  actor           users?                @relation("payment_actor", fields: [restaurant_id, actor_user_id], references: [restaurant_id, id], onDelete: SetNull, onUpdate: Restrict)
  refunded_by     users?                @relation("payment_refunded_by", fields: [restaurant_id, refunded_by_user_id], references: [restaurant_id, id], onDelete: SetNull, onUpdate: Restrict)
  allocations     payment_allocations[]
  payment_request payment_requests?

  @@unique([restaurant_id, id])
  @@unique([restaurant_id, idempotency_key])
  @@unique([restaurant_id, provider_account_id, external_payment_id], map: "payments_account_external_key")
  @@index([restaurant_id, tab_id, status])
  @@index([restaurant_id, cash_shift_id, status])
  @@index([restaurant_id, terminal_id])
  @@index([restaurant_id, provider, provider_account_id])
  @@index([provider, external_payment_id])
  @@index([status, updated_at])
  @@index([restaurant_id, actor_user_id])
  @@index([restaurant_id, refunded_by_user_id])
}

model payment_allocations {
  id                String @id @default(uuid())
  restaurant_id     String
  payment_id        String
  order_item_id     String
  covered_cents     Int
  covered_units_bps Int?

  payment    payments    @relation(fields: [restaurant_id, payment_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  order_item order_items @relation(fields: [restaurant_id, order_item_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurant_id, payment_id, order_item_id])
  @@index([restaurant_id, order_item_id])
}

enum cash_shift_status {
  OPEN
  CLOSED
}

enum cash_movement_type {
  SANGRIA
  SUPRIMENTO
}

model cash_shifts {
  id                  String            @id @default(uuid())
  restaurant_id       String
  /// Identificador histórico do operador, preservado na exclusão do usuário.
  opened_by_user_id   String
  closed_by_user_id   String?
  status              cash_shift_status @default(OPEN)
  opening_cents       Int
  expected_cash_cents Int               @default(0)
  counted_cash_cents  Int?
  difference_cents    Int?
  notes               String?           @db.VarChar(500)
  opened_at           DateTime          @default(now())
  closed_at           DateTime?

  restaurant restaurants      @relation(fields: [restaurant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// A FK SQL limpa apenas closed_by_user_id ao excluir o usuário.
  closed_by  users?           @relation("cash_shift_closed_by", fields: [restaurant_id, closed_by_user_id], references: [restaurant_id, id], onDelete: SetNull, onUpdate: Restrict)
  payments   payments[]
  movements  cash_movements[]

  @@unique([restaurant_id, id])
  @@index([restaurant_id, status, opened_at])
  @@index([restaurant_id, opened_by_user_id, opened_at])
  @@index([restaurant_id, closed_by_user_id])
}

model cash_movements {
  id            String             @id @default(uuid())
  restaurant_id String
  cash_shift_id String
  type          cash_movement_type
  amount_cents  Int
  reason        String             @db.VarChar(500)
  actor_user_id String?
  created_at    DateTime           @default(now())

  cash_shift cash_shifts @relation(fields: [restaurant_id, cash_shift_id], references: [restaurant_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// A FK SQL limpa apenas actor_user_id ao excluir o usuário.
  actor      users?      @relation("cash_movement_actor", fields: [restaurant_id, actor_user_id], references: [restaurant_id, id], onDelete: SetNull, onUpdate: Restrict)

  @@index([restaurant_id, cash_shift_id, created_at])
  @@index([restaurant_id, actor_user_id])
}

enum provider_environment {
  SANDBOX
  PRODUCTION
}

enum provider_account_status {
  ACTIVE
  REVOKED
}

model payment_provider_accounts {
  id                       String                  @id @default(uuid())
  restaurant_id            String
  provider                 payment_provider_type
  environment              provider_environment    @default(SANDBOX)
  status                   provider_account_status @default(ACTIVE)
  external_account_id      String?                 @db.VarChar(128)
  access_token_encrypted   String
  refresh_token_encrypted  String?
  token_expires_at         DateTime?
  webhook_secret_encrypted String?
  metadata_json            Json?
  created_at               DateTime                @default(now())
  updated_at               DateTime                @default(now()) @updatedAt

  restaurant restaurants         @relation(fields: [restaurant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  terminals  payment_terminals[]
  payments   payments[]

  @@unique([restaurant_id, id])
  @@unique([restaurant_id, provider, id])
  @@unique([restaurant_id, provider, environment], map: "payment_provider_accounts_identity_key")
  @@index([provider, status, token_expires_at])
}

model payment_terminals {
  id                  String                @id @default(uuid())
  restaurant_id       String
  provider_account_id String?
  provider            payment_provider_type
  external_device_id  String?               @db.VarChar(128)
  serial_number       String?               @db.VarChar(128)
  label               String                @db.VarChar(80)
  active              Boolean               @default(true)
  last_seen_at        DateTime?
  metadata_json       Json?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @default(now()) @updatedAt

  restaurant       restaurants                @relation(fields: [restaurant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider_account payment_provider_accounts? @relation(fields: [restaurant_id, provider, provider_account_id], references: [restaurant_id, provider, id], onDelete: Restrict, onUpdate: Restrict, map: "payment_terminals_account_fkey")
  payments         payments[]

  @@unique([restaurant_id, id])
  @@unique([restaurant_id, id, provider, provider_account_id], map: "payment_terminals_account_identity_key")
  @@index([restaurant_id, active])
  @@index([restaurant_id, provider, provider_account_id])
}
