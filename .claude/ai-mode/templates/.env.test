# Ambiente de TESTE (banco descartável (serviço db-test do docker-compose.yml), porta 5433).
# Valores fictícios e seguros para versionar. Nunca aponte DATABASE_URL para o banco real:
# os testes apagam todas as tabelas e recusam rodar se o nome do banco não terminar em _test.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://garcom:garcom@localhost:5433/garcom_test?schema=public
JWT_SECRET=segredo-de-teste-nao-usar-em-producao-0123456789abcdef
JWT_EXPIRES_IN=1h
TABLE_SESSION_TTL=14400
