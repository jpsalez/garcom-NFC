{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/scripts/*)",
      "Bash(python3 ./.claude/scripts/*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx prisma validate)"
    ],
    "deny": [
      "Read(./back-end/.env)",
      "Read(./back-end/node_modules/**)",
      "Read(./back-end/package-lock.json)",
      "Bash(rm -rf:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push --force-reset:*)"
    ]
  }
}
