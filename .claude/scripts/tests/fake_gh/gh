index 111..222 100644
--- a/back-end/src/main.ts
+++ b/back-end/src/main.ts
@@ -1,3 +1,3 @@
 import express from "express";
-const port = 3000;
+const port = 4000;
 app.listen(port);
"""


def flag(name):
    return argv[argv.index(name) + 1] if name in argv else None


cmd = argv[:2]
if cmd == ["pr", "list"]:
    st = flag("--state") or "open"
    out([p for p in PRS if st == "all" or p["state"].lower() == st])
if cmd == ["pr", "view"]:
    p = next((x for x in PRS if str(x["number"]) == argv[2]), None)
    if not p:
        fail("GraphQL: Could not resolve to a PullRequest with the number of " + argv[2])
    out({**p, "body": "Descrição do PR.\n\n- item um\n- item dois", "reviews": [{"author": {"login": "jpsalez"}, "state": "APPROVED", "body": "ok", "submittedAt": "2026-11-12T20:10:00Z"}],
         "commits": [{"oid": shas[0], "messageHeadline": "feat : algo", "authors": [{"login": "luan", "name": "Luan"}], "committedDate": "2026-11-12T19:00:00Z"}]})
if cmd == ["pr", "diff"]:
    print(DIFF)
    sys.exit(0)
if cmd == ["run", "list"]:
    out(RUNS)
if cmd == ["run", "view"]:
    r = next((x for x in RUNS if str(x["databaseId"]) == argv[2]), None)
    if not r:
        fail("HTTP 404: Not Found")
    if "--log-failed" in argv:
        print("test\tRun tests\t2026-11-12T21:01:09.1234567Z FAIL tests/auth.test.ts\ntest\tRun tests\t2026-11-12T21:01:09.2Z Error: expected 200 got 500")
        sys.exit(0)
    bad = r["conclusion"] == "failure"
    out({"status": r["status"], "conclusion": r["conclusion"], "workflowName": r["workflowName"], "headBranch": r["headBranch"], "headSha": r["headSha"], "displayTitle": r["displayTitle"], "url": r["url"],
         "jobs": [{"name": "build", "status": "completed", "conclusion": "success", "steps": [{"name": "Checkout", "status": "completed", "conclusion": "success"}, {"name": "Install", "status": "completed", "conclusion": "success"}]},
                  {"name": "test", "status": "completed", "conclusion": "failure" if bad else "success", "steps": [{"name": "Install", "status": "completed", "conclusion": "success"}, {"name": "Run tests", "status": "completed", "conclusion": "failure" if bad else "success"}]}]})
if cmd == ["issue", "list"]:
    out(ISSUES)
