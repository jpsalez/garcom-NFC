    {"number": 4, "title": "Decidir quem abre o atendimento (DEC-01)", "body": "Bloqueia o módulo de sessões. Ver também RF01.", "labels": [{"name": "decisão"}], "assignees": [{"login": "jpsalez"}], "author": {"login": "jpsalez"}, "updatedAt": "2026-11-12T10:00:00Z", "url": "https://github.com/jpsalez/garcom-NFC/issues/4"},
    {"number": 3, "title": "Erro 500 ao criar mesa", "body": "Sem id de tarefa aqui.", "labels": [], "assignees": [], "author": {"login": "luan"}, "updatedAt": "2026-11-09T10:00:00Z", "url": "https://github.com/jpsalez/garcom-NFC/issues/3"},
]
