# Copie para .env.prod (fica fora do git) e preencha. Usado por docker-compose.prod.yml.
# Domínio público, sem https:// (o DNS precisa apontar para este servidor)
DOMAIN=
# Senha do PostgreSQL (use caracteres seguros em URL: evite @ : / ? #)
POSTGRES_PASSWORD=
# Gere com:  openssl rand -hex 32
JWT_SECRET=
# E-mail da recuperação de senha (opcional; sem SMTP_URL nada é enviado). Ex.: smtp://usuario:senha@smtp.exemplo.com:587
SMTP_URL=
MAIL_FROM=garcom-NFC <nao-responda@exemplo.com>
